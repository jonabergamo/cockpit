{
  "name": "cockpit",
  "version": "0.1.0",
  "description": "A self-hosted dashboard for Claude Code: live sessions, browser terminals, worktrees, git and plugins in one place.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "start": "pnpm --filter server start",
    "smoke": "node scripts/smoke.mjs",
    "remote": "node scripts/remote-harness.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
