#!/usr/bin/env node
// cockpit's command line:
//
//   cockpit run [--kind k] [--name n] [--ticket T] [--artifact <path>]... [--record [--screen WxH]] -- <command...>
//   cockpit node                                   runs this machine as a node, for a hub on another machine
//   cockpit node pair --hub <id> --token <token> [--replace]
//                                                  pairs it with the hub that showed that command
//   cockpit node --adopt                           makes this machine, as it is, a node (role = "node" in config)
//   cockpit migrate export [file] | import <file> [--force]
//                                                  moves the hub's part of this cockpit to another machine
//   cockpit service install|uninstall|status [--role all|hub|node] [--print]
//                                                  runs cockpit at login: systemd on Linux, launchd on a Mac
//
// runs the command here, streams its output into a run on cockpit's Runs screen, keeps its exit code and exits with
// it. --artifact files (a report, a screenshot, a video) are kept with the run once the command ends. The kind is
// worked out from the command when left out. With cockpit down the command runs just the same.
// --record makes a video of it for a PR (Linux, with Xvfb, ffmpeg and Chromium): the command runs on a virtual
// screen (DISPLAY is set, and COCKPIT_RECORDING=1 for a test config to go headed or slower), its output shows
// beside it, and the video is kept with the run. Run browser tests headed, e.g. playwright test --headed.
// COCKPIT_URL points it at a cockpit that isn't on 127.0.0.1:8770. No dependencies.
const KINDS = ["unit", "lint", "typecheck", "audit", "e2e", "proof", "verify", "other"];
const base = (process.env.COCKPIT_URL || "http://127.0.0.1:8770").replace(/\/+$/, "");
const usage = [
  "usage: cockpit run [--kind k] [--name n] [--ticket T] [--artifact path]... [--record [--screen WxH]] -- <command...>",
  "       cockpit node",
  "       cockpit node pair --hub <id> --token <token> [--replace]",
  "       cockpit node --adopt",
  "       cockpit migrate export [file] | import <file> [--force]",
  "       cockpit service install|uninstall|status [--role all|hub|node] [--print]",
].join("\n");

async function call(path, body, timeout = 3000) {
  try {
    const res = await fetch(`${base}/api${path}`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body), signal: AbortSignal.timeout(timeout) });
    return res.ok ? await res.json() : undefined;
  } catch {
    return undefined;
  }
}

async function run(argv) {
  const { spawn } = await import("node:child_process");
  const { resolve } = await import("node:path");
  const opts = { artifacts: [] };
  let i = 0;
  for (; i < argv.length && argv[i] !== "--"; i++) {
    const [flag, value] = [argv[i], argv[i + 1]];
    if (flag === "--record") {
      opts.record = true;
      continue;
    }
    if (!["--kind", "--name", "--ticket", "--artifact", "--screen"].includes(flag) || value === undefined) throw new Error(`unknown option ${flag}\n${usage}`);
    if (flag === "--kind" && !KINDS.includes(value)) throw new Error(`--kind is one of ${KINDS.join(", ")}`);
    if (flag === "--artifact") opts.artifacts.push(resolve(value));
    else opts[flag.slice(2)] = value;
    i++;
  }
  const cmd = argv.slice(i + 1);
  if (!cmd.length) throw new Error(usage);
  // one argument is a shell line ("pnpm lint && pnpm test"), several are the command and its arguments
  const shell = cmd.length === 1;
  const command = cmd.join(" ");

  // Rerun on the Runs screen records it again the same way
  const rerun = opts.record ? [process.argv[1], "run", "--record", ...(opts.screen ? ["--screen", opts.screen] : []), ...(opts.name ? ["--name", opts.name] : []), "--kind", opts.kind || "proof", "--", ...cmd].map((a) => (/^[\w./:@=,+-]+$/.test(a) ? a : `'${a.replace(/'/g, `'\\''`)}'`)).join(" ") : undefined;
  // starting the screens takes a moment longer than a plain run
  const started = await call("/runs", { source: "wrapper", kind: opts.kind || (opts.record ? "proof" : undefined), name: opts.name, ticket: opts.ticket, command, cwd: process.cwd(), ...(opts.record ? { record: true, screen: opts.screen, video: true, rerun } : {}) }, opts.record ? 30_000 : 3000);
  const id = started?.id;
  if (id && process.stderr.isTTY) process.stderr.write(`cockpit: ${base}${started.link}\n`);
  const display = started?.display;
  if (opts.record && !display) process.stderr.write(`cockpit: not recording: ${started?.recordError ?? "cockpit isn't running"}\n`);

  // whole lines, twice a second; a heartbeat every 30s keeps a quiet run from looking dead
  let partial = "";
  let lines = [];
  let beat = Date.now();
  const take = (chunk) => {
    const parts = (partial + chunk.toString()).split("\n");
    partial = parts.pop();
    lines.push(...parts);
  };
  const flush = async (last = false) => {
    if (!id) return;
    if (last && partial) lines.push(partial), (partial = "");
    if (!lines.length && Date.now() - beat < 30_000) return;
    const batch = lines;
    lines = [];
    beat = Date.now();
    await call(`/runs/${id}/event`, { lines: batch });
  };
  // a recording shows the output beside the browser, so it goes sooner
  const timer = setInterval(() => void flush(), opts.record ? 200 : 500);

  const env = display ? { ...process.env, DISPLAY: display, COCKPIT_RECORDING: "1" } : process.env;
  const child = spawn(shell ? process.env.SHELL || "bash" : cmd[0], shell ? ["-c", cmd[0]] : cmd.slice(1), { stdio: ["inherit", "pipe", "pipe"], env });
  child.stdout.on("data", (d) => (process.stdout.write(d), take(d)));
  child.stderr.on("data", (d) => (process.stderr.write(d), take(d)));
  // Ctrl-C goes to the command, which then ends the run as cancelled
  let stopped = false;
  for (const sig of ["SIGINT", "SIGTERM"]) process.on(sig, () => ((stopped = true), child.kill(sig)));

  const code = await new Promise((done) => {
    child.on("error", (e) => (process.stderr.write(`cockpit: ${e.message}\n`), done(127)));
    child.on("close", (c, signal) => done(c ?? (signal ? 130 : 1)));
  });
  clearInterval(timer);
  await flush(true);
  if (id && display) {
    await call(`/runs/${id}/event`, { artifacts: opts.artifacts.map((path) => ({ path })), result: { status: code } });
    process.stderr.write("cockpit: making the video\n");
    const made = await call(`/runs/${id}/record/stop`, { status: code, cancelled: stopped }, 30 * 60_000);
    if (made?.file) process.stderr.write(`cockpit: video ${base}/api/runs/${id}/artifacts/${made.file} (on ${base}${started.link})\n`);
    else if (!stopped) process.stderr.write(`cockpit: no video: ${made?.error ?? "cockpit didn't answer"}\n`);
  } else if (id) await call(`/runs/${id}/event`, { artifacts: opts.artifacts.map((path) => ({ path })), result: { status: code }, phase: stopped ? "cancelled" : "done" });
  return code;
}

// The pairing a node keeps in <data>/node.json: the hash of the hub's token, never the token itself. The node
// reads it on every connection, so a running node picks it up without a restart.
async function pair(argv) {
  const { createHash } = await import("node:crypto");
  const { chmodSync, mkdirSync, readFileSync, writeFileSync } = await import("node:fs");
  const { hostname } = await import("node:os");
  const { dirname, join } = await import("node:path");
  const { fileURLToPath } = await import("node:url");
  const flag = (name) => {
    const i = argv.indexOf(name);
    return i >= 0 ? argv[i + 1] : undefined;
  };
  const hub = flag("--hub");
  const token = flag("--token");
  if (!hub || !/^[\w-]{4,64}$/.test(hub) || !token || token.length < 20) throw new Error("usage: cockpit node pair --hub <id> --token <token> [--replace]");
  const data = process.env.COCKPIT_DATA || join(dirname(dirname(fileURLToPath(import.meta.url))), "data");
  mkdirSync(data, { recursive: true });
  const file = join(data, "node.json");
  let p;
  try {
    p = JSON.parse(readFileSync(file, "utf8"));
  } catch {
    const name = hostname();
    p = { id: name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 24) || "node", name, hubs: [] };
  }
  const others = (p.hubs ?? []).filter((h) => h.hub !== hub);
  if (others.length && !argv.includes("--replace")) throw new Error(`This node is paired with another hub already (${others.map((h) => h.hub).join(", ")}). Add --replace to move it to this one.`);
  p.hubs = [{ hub, key: createHash("sha256").update(token).digest("hex"), pairedAt: Date.now() }];
  writeFileSync(file, JSON.stringify(p, null, 2));
  chmodSync(file, 0o600);
  process.stdout.write(`Paired node ${p.id} with ${hub}. Start it with \`cockpit node\` if it isn't running.\n`);
  return 0;
}

// the server, as a node: what this machine does by itself, waiting on port 8771 for its hub
async function node(argv) {
  if (argv[0] === "pair") return pair(argv.slice(1));
  if (argv[0] === "--adopt") return server("src/migrate.ts", ["adopt"]);
  if (argv.length) throw new Error(usage);
  return server("src/index.ts", [], { COCKPIT_ROLE: "node" });
}

// a file of the server, run with its tsx, in the foreground
async function server(file, args, env = {}) {
  const { spawn } = await import("node:child_process");
  const { join } = await import("node:path");
  const root = await repo();
  const child = spawn(join(root, "server/node_modules/.bin/tsx"), [join(root, "server", file), ...args], { stdio: "inherit", cwd: join(root, "server"), env: { ...process.env, ...env } });
  for (const sig of ["SIGINT", "SIGTERM"]) process.on(sig, () => child.kill(sig));
  return new Promise((done) => child.on("exit", (code) => done(code ?? 1)));
}

async function repo() {
  const { dirname } = await import("node:path");
  const { fileURLToPath } = await import("node:url");
  return dirname(dirname(fileURLToPath(import.meta.url)));
}

const migrate = (argv) => server("src/migrate.ts", argv);

// cockpit at login, as this checkout and with this shell's PATH (a service doesn't load the shell profile, so node,
// claude and the plugins' CLIs are found the way they are here). One role per machine: installing one stops the others.
async function service(argv) {
  const { execFileSync } = await import("node:child_process");
  const { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } = await import("node:fs");
  const { homedir } = await import("node:os");
  const { join } = await import("node:path");
  const [action = "status"] = argv;
  const i = argv.indexOf("--role");
  const root = await repo();
  const data = process.env.COCKPIT_DATA || join(root, "data");
  const cfg = process.env.COCKPIT_CONFIG || join(root, "config.local.toml");
  const role = (i >= 0 ? argv[i + 1] : undefined) ?? (existsSync(cfg) ? readFileSync(cfg, "utf8").match(/^role\s*=\s*"(\w+)"/m)?.[1] : undefined) ?? "all";
  if (!["all", "hub", "node"].includes(role) || !["install", "uninstall", "status"].includes(action)) throw new Error(usage);
  const tsx = join(root, "server/node_modules/.bin/tsx");
  const pass = Object.fromEntries(["COCKPIT_DATA", "COCKPIT_CONFIG"].filter((k) => process.env[k]).map((k) => [k, process.env[k]]));
  // per-shell folders (fnm's, say) are gone once this shell is, so the node running this goes first instead
  const { realpathSync } = await import("node:fs");
  const { dirname } = await import("node:path");
  const keep = (process.env.PATH ?? "").split(":").filter((p) => p && !p.includes("/fnm_multishells/") && !p.startsWith("/run/user/"));
  const PATH = [...new Set([dirname(realpathSync(process.execPath)), ...keep])].join(":");
  const env = { PATH, SHELL: process.env.SHELL || "/bin/bash", COCKPIT_ROLE: role, ...pass };
  const roles = ["all", "hub", "node"];
  const MARK = "made by cockpit service install";
  const sh = (cmd, args) => {
    try {
      return execFileSync(cmd, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
    } catch (e) {
      return e.stdout ?? "";
    }
  };

  if (process.platform === "darwin") {
    const label = (r) => (r === "all" ? "com.cockpit" : `com.cockpit.${r}`);
    const file = (r) => join(homedir(), "Library/LaunchAgents", `${label(r)}.plist`);
    const target = (r) => `gui/${process.getuid()}/${label(r)}`;
    const x = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const plist = `<?xml version="1.0" encoding="UTF-8"?>
<!-- ${MARK} -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${label(role)}</string>
  <key>ProgramArguments</key><array><string>${x(tsx)}</string><string>src/index.ts</string></array>
  <key>WorkingDirectory</key><string>${x(join(root, "server"))}</string>
  <key>EnvironmentVariables</key><dict>${Object.entries(env).map(([k, v]) => `<key>${k}</key><string>${x(v)}</string>`).join("")}</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>${x(join(data, "server.log"))}</string>
  <key>StandardErrorPath</key><string>${x(join(data, "server.log"))}</string>
</dict>
</plist>
`;
    if (argv.includes("--print")) return process.stdout.write(plist), 0;
    if (action === "status") return process.stdout.write(roles.map((r) => `${label(r)}: ${existsSync(file(r)) ? (sh("launchctl", ["print", target(r)]).match(/state = (\w+)/)?.[1] ?? "installed, not loaded") : "not installed"}`).join("\n") + "\n"), 0;
    for (const r of action === "install" ? roles : [role]) {
      if (!existsSync(file(r))) continue;
      sh("launchctl", ["bootout", target(r)]);
      // launchd loads every plist here at login, so another role's has to go or both start; one written by hand
      // is set aside rather than deleted
      if (action === "install" && r === role) continue;
      if (readFileSync(file(r), "utf8").includes(MARK)) rmSync(file(r));
      else if (action === "install") renameSync(file(r), `${file(r)}.disabled`), process.stdout.write(`Set aside ${file(r)} (now .disabled), so it doesn't start too.\n`);
    }
    if (action === "install") {
      mkdirSync(join(homedir(), "Library/LaunchAgents"), { recursive: true });
      mkdirSync(data, { recursive: true });
      writeFileSync(file(role), plist);
      execFileSync("launchctl", ["bootstrap", `gui/${process.getuid()}`, file(role)], { stdio: "inherit" });
      process.stdout.write(`cockpit runs as ${label(role)} now, and at every login. Its log is ${join(data, "server.log")}.\n`);
    }
    return 0;
  }

  const name = (r) => (r === "all" ? "cockpit" : `cockpit-${r}`);
  const dir = join(process.env.XDG_CONFIG_HOME || join(homedir(), ".config"), "systemd/user");
  const file = (r) => join(dir, `${name(r)}.service`);
  const unit = `# ${MARK}
[Unit]
Description=cockpit (${role === "all" ? "everything on this machine" : role})
After=network-online.target

[Service]
WorkingDirectory=${join(root, "server")}
${Object.entries(env).map(([k, v]) => `Environment="${k}=${v}"`).join("\n")}
EnvironmentFile=-%h/.config/cockpit/env
ExecStart=${tsx} src/index.ts
Restart=on-failure
RestartSec=5
# tsx exits with 143 when systemd stops it with SIGTERM
SuccessExitStatus=143
StandardOutput=append:${join(data, "server.log")}
StandardError=append:${join(data, "server.log")}

[Install]
WantedBy=default.target
`;
  if (argv.includes("--print")) return process.stdout.write(unit), 0;
  const ctl = (...a) => sh("systemctl", ["--user", ...a]);
  if (action === "status") return process.stdout.write(roles.map((r) => `${name(r)}.service: ${existsSync(file(r)) ? ctl("is-active", `${name(r)}.service`).trim() : "not installed"}`).join("\n") + "\n"), 0;
  for (const r of action === "install" ? roles : [role]) {
    if (!existsSync(file(r))) continue;
    ctl("disable", "--now", `${name(r)}.service`);
    if (action === "uninstall" && readFileSync(file(r), "utf8").includes(MARK)) rmSync(file(r));
  }
  if (action === "install") {
    mkdirSync(dir, { recursive: true });
    mkdirSync(data, { recursive: true });
    writeFileSync(file(role), unit);
    ctl("daemon-reload");
    execFileSync("systemctl", ["--user", "enable", "--now", `${name(role)}.service`], { stdio: "inherit" });
    process.stdout.write(`cockpit runs as ${name(role)}.service now, and at every login (with \`loginctl enable-linger\` it starts at boot). Its log is ${join(data, "server.log")}.\n`);
  } else ctl("daemon-reload");
  return 0;
}

const [sub, ...rest] = process.argv.slice(2);
const commands = { run, node, migrate, service };
if (!commands[sub]) {
  process.stderr.write(`${usage}\n`);
  process.exit(2);
}
commands[sub](rest).then(
  (code) => process.exit(code),
  (e) => {
    process.stderr.write(`${e.message}\n`);
    process.exit(2);
  },
);
